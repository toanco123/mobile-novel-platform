# Sao chép thành .env rồi điền giá trị (cùng project Supabase với web: xem web-novel-platform/.env).
# Biến EXPO_PUBLIC_* được đóng gói vào app nên chỉ đặt giá trị công khai (anon key, không phải
# service role key). Bản build trên EAS khai báo các biến này ở EAS → Environment variables.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Nút đăng nhập mạng xã hội được hiện (provider đã bật trên Supabase), vd: google, facebook, apple
# (apple: chỉ hiện trên iOS ở bản build riêng, Expo Go không có; Client IDs trên Supabase phải có bundle id)
EXPO_PUBLIC_AUTH_PROVIDERS=
# Site key CÔNG KHAI của Cloudflare Turnstile (24 ký tự, dạng 0x4AAAAAAA…), cùng site key với web
# production. Không dán secret key (35 ký tự) vào đây: biến EXPO_PUBLIC_* bị đóng gói vào app.
# Supabase Auth đang bật captcha nên thiếu biến này thì không đăng nhập bằng email được.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Địa chỉ web (mặc định DEFAULT_SITE_URL trong src/config/site.ts)
EXPO_PUBLIC_SITE_URL=
