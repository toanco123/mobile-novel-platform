{
  "expo": {
    "name": "Web Truyện",
    "slug": "web-truyen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "webtruyen",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.webtruyen.app",
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.webtruyen.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a0f1d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a0f1d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh trong thư viện để đặt làm ảnh đại diện.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "hanoi-university-of-business-a",
          "project": "mobile-novel-platform",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
